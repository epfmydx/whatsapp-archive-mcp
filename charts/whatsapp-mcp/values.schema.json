{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "app",
    "accounts",
    "worker",
    "s3",
    "storage"
  ],
  "properties": {
    "imageRegistry": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "app": {
      "type": "object",
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "baseUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "adminEmail": {
          "type": "string",
          "minLength": 3
        },
        "oauthDynamicRegistration": {
          "type": "boolean"
        },
        "oauthClients": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "client_id",
              "name",
              "redirect_uris"
            ],
            "properties": {
              "client_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              },
              "redirect_uris": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^(https://|http://(localhost|127\\.0\\.0\\.1)(:|/))"
                }
              }
            }
          }
        },
        "loginProxy": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "",
                "direct",
                "signed",
                "envoy"
              ]
            },
            "secretName": {
              "type": "string"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "webhookRelay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingSecret",
        "secretKey",
        "maxRequestsPerMinute",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[-._a-zA-Z0-9]+$"
        },
        "maxRequestsPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "sessionSecretName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,13}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "sessionSecretName": {
            "type": "string",
            "minLength": 1
          },
          "profileSlot": {
            "type": "boolean"
          }
        }
      }
    },
    "bridge": {
      "type": "object",
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "mediaRecovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "maxAttempts",
            "timeoutSeconds",
            "minIntervalSeconds"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxAttempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 15,
              "maximum": 3600
            },
            "minIntervalSeconds": {
              "type": "integer",
              "minimum": 5,
              "maximum": 3600
            }
          }
        },
        "mediaDownloadMaxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "s3": {
      "type": "object",
      "required": [
        "endpointUrl",
        "bucket",
        "region"
      ],
      "properties": {
        "endpointUrl": {
          "type": "string",
          "pattern": "^$|^https?://(\\[[0-9A-Fa-f:]+\\]|[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?)(:[0-9]{1,5})?/?$"
        },
        "publicEndpointUrl": {
          "type": "string",
          "pattern": "^$|^https?://(\\[[0-9A-Fa-f:]+\\]|[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?)(:[0-9]{1,5})?/?$"
        },
        "bucket": {
          "type": "string",
          "minLength": 3
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "addressingStyle": {
          "enum": [
            "path",
            "virtual"
          ]
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "audioChunkSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "maxAudioSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "maxMediaBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 3600,
          "maximum": 604800
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "tlsSecretName": {
          "type": "string"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "requireImageDigest": {
      "type": "boolean"
    },
    "databaseCA": {
      "type": "object",
      "properties": {
        "existingConfigMap": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ciliumNetworkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "sectionName": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cloudflareProxy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "originSecretName": {
          "type": "string"
        },
        "originSecretKey": {
          "type": "string"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "disk"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "s3",
            "disk"
          ]
        },
        "disk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingClaim",
            "storageClass",
            "size",
            "accessModes"
          ],
          "properties": {
            "existingClaim": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
            },
            "storageClass": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|Pi|Ei)$"
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "ReadWriteMany"
                ]
              }
            }
          }
        }
      }
    }
  }
}
